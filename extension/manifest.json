{
  "manifest_version": 3,
  "name": "客服链接助手 · 游戏联动",
  "version": "1.12.5",
  "description": "跟随已选游戏显示链接，同步飞书链接库；可对比客服资料大全并确认后自动新增缺少的链接。保留订单筛选、查冠名权和网页标签复用；玩家日志支持流式导出CSV。",
  "minimum_chrome_version": "121",
  "permissions": ["storage", "alarms", "clipboardWrite", "tabs", "webNavigation", "scripting"],
  "host_permissions": ["https://*.feishu.cn/*", "https://docs.qq.com/*", "https://api.github.com/*", "https://raw.githubusercontent.com/*", "https://update.cnszxyt.com/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "飞书数据管理" },
  "options_page": "manager.html",
  "content_scripts": [{
    "matches": ["https://vadmin.648sy.com/order/ls*", "https://vadmin.648sy.com/game/playerinfo*"],
    "js": ["data.js", "core.js", "entries.js", "content.js", "role-copy.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://vadmin.648sy.com/order/ls*", "https://vadmin.648sy.com/game/playerinfo*"],
    "js": ["filter-drafts.js"],
    "run_at": "document_idle",
    "world": "MAIN"
  }, {
    "matches": ["https://vadmin.648sy.com/order/ls*", "https://vadmin.648sy.com/game/playerinfo*"],
    "js": ["crown-calc.js", "crown-fetch.js", "crown-panel.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://vadmin.648sy.com/order/ls*"],
    "js": ["order-tweaks.js"],
    "css": ["order-tweaks.css"],
    "run_at": "document_idle",
    "world": "MAIN"
  }, {
    "matches": ["https://*.feishu.cn/*"],
    "js": ["tab-reuse/content/feishu-open-hook.js"],
    "run_at": "document_start",
    "all_frames": true,
    "world": "MAIN"
  }, {
    "matches": ["https://*.feishu.cn/*"],
    "js": ["tab-reuse/content/feishu-link-reuse.js"],
    "run_at": "document_start",
    "all_frames": true
  }, {
    "matches": ["https://gh3w5.17vipgame.com/gadmin/jsp/business/playerLog.jsp*"],
    "js": ["player-log-export-core.js", "player-log-export.js"],
    "run_at": "document_idle",
    "all_frames": true,
    "world": "MAIN"
  }],
  "web_accessible_resources": [{
    "resources": ["tab-reuse/background/url-normalizer.js", "tab-reuse/shared/messages.js"],
    "matches": ["https://*.feishu.cn/*"]
  }]
}
